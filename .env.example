# Copy this file to .env.local (git ignores it) and fill in your own keys.

# 511.org Bay Area transit data (Muni, BART, cable cars). Free: https://511.org/open-data/token
# Limit: 60 requests per hour per key. The dev server adds it to requests itself, so it never
# reaches the browser or GitHub.
TRANSIT_511_API_KEY=
